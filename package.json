{
  "name": "@ivcota/loadout",
  "version": "0.1.0",
  "publishConfig": {
    "access": "public"
  },
  "description": "Swap groups of AI skills in/out of your harness (Claude Code, Codex, ...). One manifest, fast toggles, crash-safe.",
  "type": "module",
  "bin": {
    "loadout": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup && chmod +x dist/cli.js",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "prepare": "npm run build",
    "prepublishOnly": "npm run build && npm test"
  },
  "keywords": [
    "claude",
    "claude-code",
    "codex",
    "skills",
    "agent",
    "cli",
    "ink",
    "effect"
  ],
  "author": "iversondiles",
  "license": "MIT",
  "dependencies": {
    "@effect/cli": "^0.75.1",
    "@effect/platform": "^0.96.0",
    "@effect/platform-node": "^0.106.0",
    "@effect/printer": "^0.49.0",
    "@effect/printer-ansi": "^0.49.0",
    "chalk": "^5.3.0",
    "effect": "^3.21.2",
    "fs-extra": "^11.2.0",
    "ink": "^7.0.3",
    "js-yaml": "^4.1.0",
    "proper-lockfile": "^4.1.2",
    "react": "^19.2.0",
    "write-file-atomic": "^5.0.1"
  },
  "devDependencies": {
    "@effect/vitest": "^0.29.0",
    "@types/fs-extra": "^11.0.4",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.7.0",
    "@types/proper-lockfile": "^4.1.4",
    "@types/react": "^19.2.0",
    "@types/write-file-atomic": "^4.0.3",
    "@vitest/coverage-v8": "^3.2.4",
    "fast-check": "^3.22.0",
    "ink-testing-library": "^4.0.0",
    "tsup": "^8.3.0",
    "tsx": "^4.22.3",
    "typescript": "^5.6.0",
    "vitest": "^3.2.0"
  }
}
